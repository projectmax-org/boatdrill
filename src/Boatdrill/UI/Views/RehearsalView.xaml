<UserControl x:Class="Boatdrill.UI.Views.RehearsalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Boatdrill.UI.Controls"
             xmlns:vm="clr-namespace:Boatdrill.UI.ViewModels"
             xmlns:drill="clr-namespace:Boatdrill.Core.Drill;assembly=Boatdrill.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RehearsalViewModel}"
             Background="{DynamicResource Brush.Base}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Header: the last rehearsal's answer ==================== -->
        <Border Grid.Row="0" Padding="24,18,24,16"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid MaxWidth="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Margin="0,11,12,0" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.TextMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HeadlineKind}" Value="good">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HeadlineKind}" Value="fair">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HeadlineKind}" Value="bad">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Sentence}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding WhenText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding WhenText, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
            <StackPanel MaxWidth="900">

                <!-- What to restore, and from where -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="REHEARSE A FULL RESTORE" Style="{StaticResource Text.SectionLabel}" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,-4,0,12"
                                   Text="Every file is restored into Boatdrill's own folder, a batch at a time, and checked against the original. Nothing is written to the backup or to your folders. It reads everything, so it takes about as long as a real restore." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Restore" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                                      ItemTemplate="{StaticResource Template.LabelText}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                                      AutomationProperties.Name="The protected folder to restore" />

                            <TextBlock Grid.Row="1" Text="Only the folder" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,8,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                     controls:Hint.Text="Leave empty to restore all of it" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                                     AutomationProperties.Name="A folder inside it, to restore alone" />
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Button.Ghost}" Content="Browse…" Margin="6,8,0,0"
                                    Command="{Binding BrowseCommand}" AutomationProperties.Name="Choose a folder inside it" />

                            <TextBlock Grid.Row="2" Text="From" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,8,0,0" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}" Margin="0,8,0,0"
                                      ItemTemplate="{StaticResource Template.LabelText}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                                      AutomationProperties.Name="The backup to restore from" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource Button.Accent}" Padding="16,8" Command="{Binding StartCommand}" Content="Restore it all"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            <Button Padding="16,8" Command="{Binding StopCommand}" Content="Stop"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Height="4" Minimum="0" Maximum="1" Background="{DynamicResource Brush.Pressed}"
                                         Value="{Binding ProgressValue, Mode=OneWay}" />
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Caption}" Margin="0,7,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   Visibility="{Binding ErrorText, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- The last rehearsal, counted -->
                <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,0,-8,14" Focusable="False"
                              Visibility="{Binding Tiles, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type drill:ScorePart}">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name, Mode=OneTime}" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding Value, Mode=OneTime}" FontFamily="{StaticResource Font.Display}"
                                               FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Detail, Mode=OneTime}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                        Visibility="{Binding Findings, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="FILES THAT DID NOT COME BACK INTACT" Style="{StaticResource Text.SectionLabel}" />
                        <ItemsControl ItemsSource="{Binding Findings}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FindingRow}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Badge.ByKind}" Tag="{Binding Kind, Mode=OneTime}"
                                                CornerRadius="{StaticResource CornerRadius.Small}"
                                                Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Outcome, Mode=OneTime}" Style="{StaticResource Text.ByKind}" Tag="{Binding Kind, Mode=OneTime}"
                                                       FontSize="11.5" FontWeight="SemiBold" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Path, Mode=OneTime}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail, Mode=OneTime}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,1,0,0"
                                                       Visibility="{Binding Detail, Mode=OneTime, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
