<UserControl x:Class="Boatdrill.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Boatdrill.UI.Controls"
             xmlns:vm="clr-namespace:Boatdrill.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             Background="{DynamicResource Brush.Base}">

    <UserControl.Resources>
        <!-- A row with a title, a line of explanation, and a switch on the right. -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="48" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Header ==================== -->
        <Border Grid.Row="0" Padding="24,18,24,16"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel MaxWidth="900">
                <TextBlock Text="Settings" Style="{StaticResource Text.Title}" />
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                           Text="What to protect, where its backup is, and when to rehearse a restore. Every change is saved as you make it." />

                <Border CornerRadius="{StaticResource CornerRadius.Small}"
                        Padding="10,6" Margin="0,12,0,0" HorizontalAlignment="Left"
                        Visibility="{Binding Message, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsWarning}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Info}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" MaxWidth="760" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
            <StackPanel MaxWidth="900">

                <!-- ============================================================
                     What to protect
                     ============================================================ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="WHAT TO PROTECT" Style="{StaticResource Text.SectionLabel}" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,-4,0,12"
                                   Text="The folders whose files must come back. Each drill picks a sample of their files, favouring the ones changed recently." />

                        <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SourceRowViewModel}">
                                    <Border Background="{DynamicResource Brush.SurfaceAlt}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="{StaticResource CornerRadius.Medium}"
                                            Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Style="{StaticResource Icon}" Data="{DynamicResource Icon.Folder}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name, Mode=OneTime}" Style="{StaticResource Text.Subheading}" />
                                                <TextBlock Text="{Binding Folder, Mode=OneTime}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Excludes, Mode=OneTime}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource Button.Icon}" VerticalAlignment="Center"
                                                    ToolTip="Stop protecting this folder" AutomationProperties.Name="Stop protecting this folder"
                                                    Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Trash}" Stroke="{DynamicResource Brush.Danger}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding AddSourceCommand}" AutomationProperties.Name="Add a folder to protect">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Plus}" />
                                <TextBlock Text="Add a folder" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ============================================================
                     Where the backups are
                     ============================================================ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="WHERE YOUR BACKUPS ARE" Style="{StaticResource Text.SectionLabel}" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,-4,0,12"
                                   Text="An external drive, a network share, a folder that OneDrive, Dropbox or Google Drive keeps in step, a File History drive, a restic repository or an rclone remote. Boatdrill only ever reads from these." />

                        <ItemsControl ItemsSource="{Binding Destinations}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DestinationRowViewModel}">
                                    <Border Background="{DynamicResource Brush.SurfaceAlt}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="{StaticResource CornerRadius.Medium}"
                                            Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Path Style="{StaticResource Icon}" Data="{Binding Kind, Mode=OneTime, Converter={StaticResource DestinationIcon}}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" controls:Hint.Text="A name for this backup"
                                                         MaxWidth="360" HorizontalAlignment="Left" MinWidth="220"
                                                         AutomationProperties.Name="Name of this backup" />
                                                <TextBlock Text="{Binding Folder, Mode=OneTime}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="2,5,0,0" />
                                                <TextBlock Text="{Binding PasswordNote, Mode=OneTime}" TextWrapping="Wrap" Margin="2,4,0,0"
                                                           Visibility="{Binding PasswordNote, Mode=OneTime, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PasswordMissing, Mode=OneTime}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource Button.Icon}" VerticalAlignment="Center"
                                                    ToolTip="Stop checking this backup" AutomationProperties.Name="Stop checking this backup"
                                                    Command="{Binding DataContext.RemoveDestinationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Trash}" Stroke="{DynamicResource Brush.Danger}" />
                                            </Button>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="12,10,0,0"
                                                        Visibility="{Binding HasLayout, Mode=OneTime, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Copies are kept as" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <ComboBox MinWidth="290" ItemsSource="{Binding LayoutChoices, Mode=OneTime}"
                                                          SelectedItem="{Binding Layout}"
                                                          ItemTemplate="{StaticResource Template.LabelText}"
                                                          AutomationProperties.Name="How the copies are laid out" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- A repository or a remote needs more than a folder: where it is, perhaps a password, and its tool. -->
                        <Border Margin="0,0,0,10" Padding="14,12"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadius.Medium}"
                                Visibility="{Binding IsAddingTool, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Form.Title}" Style="{StaticResource Text.Subheading}" />
                                <TextBlock Text="{Binding Form.Intro}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Form.LocationLabel}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding NewToolLocation, UpdateSourceTrigger=PropertyChanged}"
                                             controls:Hint.Text="{Binding Form.LocationHint}"
                                             AutomationProperties.Name="{Binding Form.LocationLabel}" />
                                    <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Content="Browse…" Margin="6,0,0,0"
                                            Command="{Binding BrowseToolCommand}" AutomationProperties.Name="Choose the repository's folder"
                                            Visibility="{Binding Form.CanBrowse, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Grid.Row="1" Text="{Binding Form.PasswordLabel}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="ToolPassword" Margin="0,8,0,0"
                                                 AutomationProperties.Name="{Binding Form.PasswordLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Form.PasswordHint}" Style="{StaticResource Text.Caption}" Margin="2,4,0,0"
                                               Visibility="{Binding Form.PasswordHint, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Grid.Row="3" Text="{Binding Form.ToolLabel}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding NewToolPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                             controls:Hint.Text="{Binding Form.ToolHint}"
                                             AutomationProperties.Name="{Binding Form.ToolLabel}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource Button.Accent}" Content="{Binding Form.AddText}" Click="AddTool_Click" Padding="14,6" />
                                    <Button Content="Cancel" Click="CancelTool_Click" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Command="{Binding AddDestinationCommand}" Margin="0,0,8,8" AutomationProperties.Name="Add a backup folder or drive">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Plus}" />
                                    <TextBlock Text="Add a folder or drive" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddFileHistoryCommand}" Margin="0,0,8,8" AutomationProperties.Name="Add a File History drive">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Versions}" />
                                    <TextBlock Text="Add File History" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddArchivesCommand}" Margin="0,0,8,8" AutomationProperties.Name="Add a folder of zip or 7z archives">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Archive}" />
                                    <TextBlock Text="Add zip or 7z archives" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StartResticCommand}" Margin="0,0,8,8" AutomationProperties.Name="Add a restic repository">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Repository}" />
                                    <TextBlock Text="Add a restic repository" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StartRcloneCommand}" Margin="0,0,8,8" AutomationProperties.Name="Add an rclone remote">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Cloud}" />
                                    <TextBlock Text="Add an rclone remote" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                    Visibility="{Binding IsTestingTool, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Width="120" Height="4" IsIndeterminate="True" Background="{DynamicResource Brush.Pressed}" VerticalAlignment="Center" />
                            <TextBlock Text="Opening it to check that it works…" Style="{StaticResource Text.Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================================================
                     When to drill
                     ============================================================ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="WHEN TO DRILL" Style="{StaticResource Text.SectionLabel}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="How often" Style="{StaticResource Text.Subheading}" />
                                <TextBlock Text="Counted from the last drill, including one you run yourself."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource Chip}" GroupName="Frequency" Content="Daily" IsChecked="{Binding IsDaily}" Margin="0,0,6,0" />
                                <RadioButton Style="{StaticResource Chip}" GroupName="Frequency" Content="Weekly" IsChecked="{Binding IsWeekly}" Margin="0,0,6,0" />
                                <RadioButton Style="{StaticResource Chip}" GroupName="Frequency" Content="Monthly" IsChecked="{Binding IsMonthly}" Margin="0,0,6,0" />
                                <RadioButton Style="{StaticResource Chip}" GroupName="Frequency" Content="Off" IsChecked="{Binding IsOff}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Only when you step away" Style="{StaticResource Text.Subheading}" />
                                <TextBlock Text="Waits until the keyboard and mouse have been idle for five minutes. After a day of waiting, it runs at the next chance."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding OnlyWhenAway}" AutomationProperties.Name="Only when you step away" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Only when plugged in" Style="{StaticResource Text.Subheading}" />
                                <TextBlock Text="On a laptop, waits for mains power. After three days of waiting, it runs on battery too."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding OnlyOnMainsPower}" AutomationProperties.Name="Only when plugged in" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Tell me when a backup would not restore" Style="{StaticResource Text.Subheading}" />
                                <TextBlock Text="A Windows notification after a drill that finds a problem. Silence when everything would restore. Never during games or presentations."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding NotifyOnProblems}" AutomationProperties.Name="Tell me when a backup would not restore" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================================================
                     How much to read
                     ============================================================ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="HOW MUCH TO READ" Style="{StaticResource Text.SectionLabel}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Files sampled from each folder" Style="{StaticResource Text.Subheading}" />
                                <TextBlock Text="More files give a tighter estimate and take longer. The margin of error is shown beside every coverage figure."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="230" VerticalAlignment="Center"
                                      ItemsSource="{Binding SampleSizes, Mode=OneTime}" SelectedItem="{Binding SelectedSampleSize}"
                                      ItemTemplate="{StaticResource Template.LabelText}" AutomationProperties.Name="Files sampled from each folder" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Most data read from each folder" Style="{StaticResource Text.Subheading}" />
                                <TextBlock Text="Keeps a drill to minutes, even over a slow USB drive or Wi-Fi. The largest files are dropped from the sample first."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="230" VerticalAlignment="Center"
                                      ItemsSource="{Binding ByteCaps, Mode=OneTime}" SelectedItem="{Binding SelectedByteCap}"
                                      ItemTemplate="{StaticResource Template.LabelText}" AutomationProperties.Name="Most data read from each folder" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================================================
                     Extra checks
                     ============================================================ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="EXTRA CHECKS" Style="{StaticResource Text.SectionLabel}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Read earlier copies again, for bit rot" Style="{StaticResource Text.Subheading}" />
                                <TextBlock Text="Boatdrill remembers each copy that read back correctly. Every drill reads a few of them again: one that changed while its name, size and date did not has decayed on the disk."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding RecheckForBitRot}" AutomationProperties.Name="Read earlier copies again, for bit rot" />
                        </Grid>

                        <Grid Style="{StaticResource Row}" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Canary files" Style="{StaticResource Text.Subheading}" />
                                <TextBlock Text="Keeps a small file named &quot;Boatdrill canary.txt&quot; in each protected folder and adds the time to it after every drill. Each backup's copy of it then shows when that backup last ran, even when nothing else changed. The only thing Boatdrill writes to your folders."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding UseCanaries}" AutomationProperties.Name="Canary files" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================================================
                     The app
                     ============================================================ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="THE APP" Style="{StaticResource Text.SectionLabel}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Start with Windows" Style="{StaticResource Text.Subheading}" />
                                <TextBlock Text="Scheduled drills only run while Boatdrill is running. It starts in the notification area and does nothing until a drill is due."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Start with Windows" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Keep running in the notification area" Style="{StaticResource Text.Subheading}" />
                                <TextBlock Text="Closing the window leaves Boatdrill waiting for the next drill. Quit from the icon's menu."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding KeepRunningInTray}" AutomationProperties.Name="Keep running in the notification area" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Appearance" Style="{StaticResource Text.Subheading}" />
                                <TextBlock Text="Follow Windows, or choose light or dark."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource Chip}" GroupName="Theme" Content="Windows" IsChecked="{Binding IsSystemTheme}" Margin="0,0,6,0" />
                                <RadioButton Style="{StaticResource Chip}" GroupName="Theme" Content="Light" IsChecked="{Binding IsLightTheme}" Margin="0,0,6,0" />
                                <RadioButton Style="{StaticResource Chip}" GroupName="Theme" Content="Dark" IsChecked="{Binding IsDarkTheme}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Subheading}" />
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="A Project Max app. Free and open source under the MIT licence. No account, no telemetry: nothing leaves this PC." />
                                <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Button.Ghost}" Content="Data folder" Command="{Binding OpenDataFolderCommand}" />
                                <Button Style="{StaticResource Button.Ghost}" Content="Log" Command="{Binding OpenLogCommand}" Margin="4,0,0,0" />
                                <Button Style="{StaticResource Button.Ghost}" Content="Source code" Command="{Binding OpenRepositoryCommand}" Margin="4,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
