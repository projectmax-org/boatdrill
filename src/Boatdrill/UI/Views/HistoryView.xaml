<UserControl x:Class="Boatdrill.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Boatdrill.UI"
             xmlns:vm="clr-namespace:Boatdrill.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
             Background="{DynamicResource Brush.Base}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,18,24,16"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel MaxWidth="900">
                <TextBlock Text="{ui:Say 'Drill history', '복원 훈련 기록'}" Style="{StaticResource Text.Title}" />
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                           Text="{ui:Say 'Every drill so far, newest first, with each backup\'s score. A backup that keeps dropping out, or slowly falls behind, shows here first.', '지금까지의 복원 훈련을 최근 것부터 백업별 점수와 함께 보여 줍니다. 자꾸 연결이 끊기거나 조금씩 뒤처지는 백업은 여기에서 먼저 드러납니다.'}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
            <StackPanel MaxWidth="900">
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{ui:Say 'No drills yet', '아직 복원 훈련 기록이 없습니다'}" Style="{StaticResource Text.Heading}" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                                   Text="{ui:Say 'The first drill appears here as soon as it finishes.', '첫 복원 훈련이 끝나면 바로 여기에 나타납니다.'}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Path Grid.Column="0" Style="{StaticResource Icon.ByKind}" Tag="{Binding Kind, Mode=OneTime}"
                                          Data="{DynamicResource Icon.Ring}" VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding When, Mode=OneTime}" Style="{StaticResource Text.Subheading}" />
                                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                                            <Run Text="{Binding How, Mode=OneTime}" /><Run Text=" · " /><Run Text="{Binding Files, Mode=OneTime}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Destinations, Mode=OneTime}" Focusable="False" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:HistoryCell}">
                                                <Border Style="{StaticResource Badge.ByKind}" Tag="{Binding Kind, Mode=OneTime}"
                                                        Padding="10,5" Margin="0,3,8,3" ToolTip="{Binding Verdict, Mode=OneTime}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name, Mode=OneTime}" FontSize="12.5" />
                                                        <TextBlock Text="{Binding Score, Mode=OneTime}" Style="{StaticResource Text.ByKind}" Tag="{Binding Kind, Mode=OneTime}"
                                                                   FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Column="3" Text="{Binding Duration, Mode=OneTime}" Style="{StaticResource Text.Caption}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
