<Application x:Class="Boatdrill.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Boatdrill.UI"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the palette and is swapped at runtime by ThemeManager.
                     Everything after it refers to the palette with DynamicResource. -->
                <ResourceDictionary Source="UI/Theme/Palette.Light.xaml" />
                <ResourceDictionary Source="UI/Theme/Icons.xaml" />
                <ResourceDictionary Source="UI/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ui:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <ui:InverseBoolConverter x:Key="InverseBool" />

            <!-- Colours a TextBlock by a verdict kind: good, fair, bad or none. -->
            <Style x:Key="Text.ByKind" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="good">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="fair">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="bad">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A rounded tint behind a verdict, by the same kinds. -->
            <Style x:Key="Badge.ByKind" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Medium}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="good">
                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="fair">
                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="bad">
                        <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A stroked icon coloured by the same kinds. -->
            <Style x:Key="Icon.ByKind" TargetType="Path" BasedOn="{StaticResource Icon}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="good">
                        <Setter Property="Stroke" Value="{DynamicResource Brush.Success}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="fair">
                        <Setter Property="Stroke" Value="{DynamicResource Brush.Warning}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="bad">
                        <Setter Property="Stroke" Value="{DynamicResource Brush.Danger}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
