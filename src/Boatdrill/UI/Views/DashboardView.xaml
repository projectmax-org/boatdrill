<UserControl x:Class="Boatdrill.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Boatdrill.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Background="{DynamicResource Brush.Base}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Header: the answer first ==================== -->
        <Border Grid.Row="0" Padding="24,18,24,16"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid MaxWidth="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Margin="0,11,12,0"
                        VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.TextMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HeadlineKind}" Value="good">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HeadlineKind}" Value="fair">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HeadlineKind}" Value="bad">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Protecting}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding Protecting, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Cards ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
            <StackPanel MaxWidth="900">

                <!-- Not set up yet: one clear next step. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                        Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Two things and Boatdrill can start" Style="{StaticResource Text.Heading}" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,14"
                                   Text="Tell it which folders matter, and where their backup is kept: an external drive, a network share, or a folder that OneDrive, Dropbox or Google Drive keeps in step. It never writes to the backup." />
                        <Button Style="{StaticResource Button.Accent}" HorizontalAlignment="Left" Padding="16,8"
                                Command="{Binding OpenSettingsCommand}" Content="{Binding SetupButtonText}" />
                    </StackPanel>
                </Border>

                <!-- Set up, never drilled. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                        Visibility="{Binding CanRunFirstDrill, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Run the first drill now?" Style="{StaticResource Text.Heading}" />
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,0"
                                       Text="Otherwise it runs on schedule, the next time you step away from the PC." />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Button.Accent}" Padding="16,8" VerticalAlignment="Center"
                                Command="{Binding RunDrillCommand}" Content="Run a drill now" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DestinationCardViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <!-- Name, where, score -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="42" Height="42" Style="{StaticResource Badge.ByKind}"
                                                Tag="{Binding VerdictKind}" VerticalAlignment="Center">
                                            <Path Style="{StaticResource Icon.ByKind}" Tag="{Binding VerdictKind}"
                                                  Data="{DynamicResource Icon.Drive}" Width="20" Height="20" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ScoreText}" Style="{StaticResource Text.ByKind}" Tag="{Binding VerdictKind}"
                                                       FontFamily="{StaticResource Font.Display}" FontSize="30" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding VerdictText}" Style="{StaticResource Text.ByKind}" Tag="{Binding VerdictKind}"
                                                       FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,-2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- The plain-language verdict -->
                                    <TextBlock Text="{Binding Sentence}" Style="{StaticResource Text.Body}" Margin="0,14,0,0" />

                                    <!-- The four parts of the score -->
                                    <ItemsControl ItemsSource="{Binding Parts}" Margin="0,14,-8,0" Focusable="False"
                                                  Visibility="{Binding HasParts, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ScorePart}">
                                                <Border Background="{DynamicResource Brush.SurfaceAlt}"
                                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                        CornerRadius="{StaticResource CornerRadius.Medium}"
                                                        Padding="12,9" Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name, Mode=OneTime}" Style="{StaticResource Text.Caption}" />
                                                        <TextBlock Text="{Binding Value, Mode=OneTime}" FontFamily="{StaticResource Font.Display}"
                                                                   FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding Detail, Mode=OneTime}" Style="{StaticResource Text.Caption}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- When, and what to do next -->
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CheckedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding ToggleFindingsCommand}"
                                                    Content="{Binding FindingsToggleText}"
                                                    Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenFolderCommand}" Margin="4,0,0,0"
                                                    ToolTip="{Binding Folder}" Content="Open the backup folder" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- The files that did not verify -->
                                    <Border Margin="0,10,0,0" Padding="12,8"
                                            Background="{DynamicResource Brush.SurfaceAlt}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="{StaticResource CornerRadius.Medium}"
                                            Visibility="{Binding ShowFindings, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Findings}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:FindingRow}">
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="92" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Style="{StaticResource Badge.ByKind}" Tag="{Binding Kind, Mode=OneTime}"
                                                                    CornerRadius="{StaticResource CornerRadius.Small}"
                                                                    Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding Outcome, Mode=OneTime}" Style="{StaticResource Text.ByKind}" Tag="{Binding Kind, Mode=OneTime}"
                                                                           FontSize="11.5" FontWeight="SemiBold" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Path, Mode=OneTime}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Detail, Mode=OneTime}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,1,0,0"
                                                                           Visibility="{Binding Detail, Mode=OneTime, Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding FindingsNote}" Style="{StaticResource Text.Caption}" Margin="0,6,0,2"
                                                       Visibility="{Binding FindingsNote, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
