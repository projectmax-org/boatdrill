<Window x:Class="Boatdrill.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Boatdrill.UI.ViewModels"
        xmlns:views="clr-namespace:Boatdrill.UI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Boatdrill"
        Width="1080" Height="740"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Brush.Base}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="{DynamicResource Brush.Base}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Title bar ==================== -->
        <Grid Grid.Row="0" Background="{DynamicResource Brush.Surface}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <!-- The same drawing as app.ico, so the title bar, taskbar and tray show one mark. -->
                <Image Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Source>
                        <BitmapImage UriSource="pack://application:,,,/Assets/logo-512.png" DecodePixelWidth="80" />
                    </Image.Source>
                </Image>
                <TextBlock Text="Boatdrill"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center" />
                <Border Background="{DynamicResource Brush.Border}" Width="1" Height="16" Margin="14,0" />
                <TextBlock Text="{Binding SectionTitle}"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Button.Caption}" Click="OnMinimize" ToolTip="Minimise" AutomationProperties.Name="Minimise">
                    <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Minimize}" />
                </Button>
                <Button Style="{StaticResource Button.Caption}" Click="OnMaximize" ToolTip="Maximise" AutomationProperties.Name="Maximise">
                    <Border Width="11" Height="11" BorderThickness="1.6"
                            BorderBrush="{DynamicResource Brush.TextSecondary}" CornerRadius="2" />
                </Button>
                <Button Style="{StaticResource Button.CaptionClose}" Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close">
                    <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Close}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== Body ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="NavRail" Grid.Row="0" Margin="0,12,0,0">
                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav"
                                     IsChecked="{Binding IsDashboard, Mode=TwoWay}"
                                     Content="Backups">
                            <RadioButton.Tag>
                                <Path Style="{StaticResource Icon}" Data="{DynamicResource Icon.Ring}" />
                            </RadioButton.Tag>
                        </RadioButton>

                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav"
                                     IsChecked="{Binding IsHistory, Mode=TwoWay}"
                                     Content="History">
                            <RadioButton.Tag>
                                <Path Style="{StaticResource Icon}" Data="{DynamicResource Icon.History}" />
                            </RadioButton.Tag>
                        </RadioButton>

                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav"
                                     IsChecked="{Binding IsSettings, Mode=TwoWay}"
                                     Content="Settings">
                            <RadioButton.Tag>
                                <Path Style="{StaticResource Icon}" Data="{DynamicResource Icon.Settings}" />
                            </RadioButton.Tag>
                        </RadioButton>
                    </StackPanel>

                    <!-- The drill box: when the next one is due, how the running one is going, and the button. -->
                    <Border Grid.Row="2" Margin="12" Padding="14"
                            Background="{DynamicResource Brush.Base}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadius.Large}"
                            SnapsToDevicePixels="True">
                        <StackPanel>
                            <TextBlock Text="NEXT DRILL" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding NextDrillText}" Style="{StaticResource Text.Body}" FontSize="12.5" LineHeight="18" />

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar Height="4" Minimum="0" Maximum="1"
                                             Background="{DynamicResource Brush.Pressed}"
                                             Value="{Binding ProgressValue, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap" Margin="0,7,0,0" />
                            </StackPanel>

                            <Button Style="{StaticResource Button.Accent}" Margin="0,12,0,0"
                                    HorizontalAlignment="Stretch" MinHeight="34"
                                    Command="{Binding RunDrillCommand}"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                    AutomationProperties.Name="Run a drill now">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Play}"
                                          Stroke="{DynamicResource Brush.TextOnAccent}" />
                                    <TextBlock Text="Run a drill now" Margin="7,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextOnAccent}" />
                                </StackPanel>
                            </Button>

                            <Button Margin="0,12,0,0" HorizontalAlignment="Stretch" MinHeight="34"
                                    Command="{Binding StopDrillCommand}"
                                    Content="Stop the drill"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid x:Name="ContentHost" Grid.Column="1">
                <views:DashboardView DataContext="{Binding Dashboard}"
                                     Visibility="{Binding DataContext.IsDashboard, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <views:HistoryView DataContext="{Binding History}"
                                   Visibility="{Binding DataContext.IsHistory, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <views:SettingsView DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.IsSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>

        <!-- ==================== Status bar ==================== -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="14,7">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11.5"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>
