<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Boatdrill</AssemblyName>
    <RootNamespace>Boatdrill</RootNamespace>
    <AssemblyTitle>Boatdrill</AssemblyTitle>
    <Description>Rehearses restoring from your backups on a schedule and says, in plain words, whether they would work.</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Lets the WPF project compile (not run) on Linux and macOS, which is how CI and the engine's
         authors check it without a Windows machine. -->
    <EnableWindowsTargeting Condition="!$([MSBuild]::IsOSPlatform('Windows'))">true</EnableWindowsTargeting>

    <!-- Runtime tuning: keep the idle footprint small. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- The WindowsDesktop SDK's implicit usings omit System.IO; the codebase assumes it. -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- app.ico becomes the executable's Win32 icon (read back from there for the tray icon, which keeps
       single-file publishing to one file); logo-512.png is a WPF resource for the title bar. Both come
       from tools/IconGen. -->
  <ItemGroup>
    <None Update="Assets\**" CopyToOutputDirectory="Never" />
    <None Remove="Assets\logo-512.png" />
    <Resource Include="Assets\logo-512.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Boatdrill.Core\Boatdrill.Core.csproj" />
  </ItemGroup>

</Project>
