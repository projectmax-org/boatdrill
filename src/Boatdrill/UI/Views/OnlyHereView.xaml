<UserControl x:Class="Boatdrill.UI.Views.OnlyHereView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Boatdrill.UI"
             xmlns:vm="clr-namespace:Boatdrill.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OnlyHereViewModel}"
             Background="{DynamicResource Brush.Base}">

    <UserControl.Resources>
        <!-- A size, a path and a line of detail: the folders and the files at risk. -->
        <DataTemplate x:Key="Template.AtRisk" DataType="{x:Type vm:AtRiskRow}">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Size, Mode=OneTime}" FontFamily="{StaticResource Font.Display}" FontWeight="SemiBold"
                           HorizontalAlignment="Right" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Path, Mode=OneTime}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail, Mode=OneTime}" Style="{StaticResource Text.Caption}" Margin="0,1,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Header: the answer first ==================== -->
        <Border Grid.Row="0" Padding="24,18,24,16"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid MaxWidth="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Margin="0,11,12,0" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.TextMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HeadlineKind}" Value="good">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HeadlineKind}" Value="fair">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HeadlineKind}" Value="bad">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Sentence}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding WhenText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding WhenText, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding UnreachableText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.Warning}"
                               Visibility="{Binding UnreachableText, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.Danger}"
                               Visibility="{Binding ErrorText, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Height="4" MaxWidth="360" HorizontalAlignment="Left" Width="360"
                                     IsIndeterminate="True" Background="{DynamicResource Brush.Pressed}" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Caption}" Margin="0,7,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <Button Style="{StaticResource Button.Accent}" Padding="16,8" Command="{Binding ScanCommand}"
                            Content="{Binding ScanButtonText}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <Button Padding="16,8" Command="{Binding StopCommand}" Content="{ui:Say 'Stop', '멈추기'}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
            <StackPanel MaxWidth="900">

                <!-- Each protected folder: how much of it exists only here. -->
                <ItemsControl ItemsSource="{Binding Sources}" Margin="0,0,-8,14" Focusable="False"
                              Visibility="{Binding Sources, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AtRiskSource}">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon.Small}" Data="{DynamicResource Icon.Folder}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name, Mode=OneTime}" Style="{StaticResource Text.Subheading}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Value, Mode=OneTime}" FontFamily="{StaticResource Font.Display}"
                                               FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Detail, Mode=OneTime}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                        Visibility="{Binding Folders, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{ui:Say 'FOLDERS WITH THE MOST ONLY HERE', '이 PC에만 있는 파일이 가장 많은 폴더'}" Style="{StaticResource Text.SectionLabel}" />
                        <ItemsControl ItemsSource="{Binding Folders}" ItemTemplate="{StaticResource Template.AtRisk}" Focusable="False" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                        Visibility="{Binding Files, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{ui:Say 'LARGEST FILES ONLY HERE', '이 PC에만 있는 가장 큰 파일'}" Style="{StaticResource Text.SectionLabel}" />
                        <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource Template.AtRisk}" Focusable="False" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,0,0,0"
                           Text="{ui:Say 'A file counts as backed up when any backup holds a copy at least as new as the file; a cloud-only copy counts. Run a drill to check that the copies would actually restore.', '어느 백업에든 파일보다 오래되지 않은 사본이 있으면 백업된 것으로 봅니다. 클라우드에만 있는 사본도 포함됩니다. 그 사본으로 실제로 복원할 수 있는지는 복원 훈련으로 확인하세요.'}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
